{
    "name": "tv-app-client",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "description": "TV app client",
    "author": "Christian Torrealba",
    "license": "ISC",
    "config": {
        "host": "http://localhost:3000"
    },
    "scripts": {
        "dev": "vite",
        "dev:e2e": "NODE_ENV=e2e vite",
        "build": "tsc && vite build",
        "build:prod": "tsc && vite build --mode production",
        "lint": "biome check .",
        "preview": "vite preview",
        "precommit": "lint-staged",
        "prepare": "husky install",
        "test": "jest --no-cache --detectOpenHandles --forceExit",
        "cy:open": "cypress open",
        "cy:run": "cypress run --e2e",
        "cy:test": "npm run build:shared-types --prefix .. && npm run build --prefix ../server && start-server-and-test 'concurrently -k -n tmdb,api,client \"node ../scripts/mockTmdb.mjs\" \"cd ../server && NODE_ENV=e2e TMDB_BASE_URL=http://127.0.0.1:4000 TMDB_API_VERSION=3 TMDB_API_KEY=stub TMDB_API_ACCESS_TOKEN=stub TMBD_SECURE_BASE_URL_IMAGE=https://example.org SERVER_PORT=3001 CACHE_STDTTL=60 node dist/bundle.js\" \"VITE_ENABLE_API_MOCK=false npm run dev:e2e\"' 'http://127.0.0.1:4000/health|http://127.0.0.1:3001/api/docs/|http://localhost:3000/tv-app' 'npm run cy:run'",
        "cy:e2e": "start-server-and-test dev:e2e $npm_package_config_host cy:open",
        "ts:trace-resolution": "tsc --traceResolution"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "biome check --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run precommit"
        }
    },
    "jest": {
        "clearMocks": true,
        "collectCoverage": true,
        "coverageDirectory": "coverage",
        "setupFiles": [
            "<rootDir>/setup-jest.ts"
        ],
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "moduleFileExtensions": [
            "js",
            "ts",
            "tsx"
        ],
        "preset": "ts-jest",
        "testEnvironment": "jsdom",
        "testMatch": [
            "**/__tests__/**/*.[jt]s?(x)",
            "**/?(*.)+(spec|test).[tj]s?(x)"
        ],
        "transform": {
            ".+\\.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "jest-transform-stub",
            "^.+\\.tsx?$": "babel-jest",
            "^.+\\.svg$": "jest-transform-stub"
        },
        "moduleNameMapper": {
            "^@services(.*)$": "<rootDir>/src/services$1",
            "^@hooks(.*)$": "<rootDir>/src/hooks$1",
            "^@pages(.*)$": "<rootDir>/src/pages$1",
            "^@configuration(.*)$": "<rootDir>/src/configuration$1",
            "^@app-types(.*)$": "<rootDir>/src/types$1",
            "^@components(.*)$": "<rootDir>/src/components$1",
            "^@assets(.*)$": "<rootDir>/src/assets$1",
            "^@layout(.*)$": "<rootDir>/src/layout$1",
            "^@routes(.*)$": "<rootDir>/src/routes$1"
        }
    },
    "dependencies": {
        "@glidejs/glide": "^3.6.0",
        "@tv-app-packages/shared-types": "^1.0.0",
        "joi": "17.13.9",
        "nodemon": "3.1.11",
        "qs": "^6.12.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.7"
    },
    "devDependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7.23.3",
        "@babel/preset-env": "^7.24.0",
        "@babel/preset-react": "^7.23.3",
        "@babel/preset-typescript": "^7.23.3",
        "@tailwindcss/typography": "^0.5.4",
        "@tailwindcss/vite": "4.3.5",
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "16.3.3",
        "@types/glidejs__glide": "^3.6.5",
        "@types/jest": "30.0.0",
        "@types/qs": "^6.9.12",
        "@types/react": "19.3.3",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "babel-jest": "^30.4.1",
        "cypress": "16.4.0",
        "cypress-vite": "1.10.2",
        "cypress-wait-until": "^3.0.1",
        "daisyui": "5.8.3",
        "dotenv": "^16.4.5",
        "http-status": "^1.7.3",
        "husky": "^9.0.11",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "30.5.2",
        "jest-transform-stub": "^2.0.0",
        "jest-transformer-svg": "^2.0.2",
        "lint-staged": "^15.2.2",
        "start-server-and-test": "^2.0.3",
        "tailwindcss": "4.3.5",
        "ts-jest": "29.4.15",
        "ts-node": "^10.9.2",
        "ts-patch": "^3.1.2",
        "tsconfig-paths": "^4.2.0",
        "typescript-transform-paths": "^3.4.7"
    }
}
