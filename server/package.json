{
    "name": "tv-app-server",
    "version": "1.0.0",
    "description": "TV app server",
    "main": "main.ts",
    "author": "Christian Torrealba",
    "private": true,
    "license": "ISC",
    "scripts": {
        "dev": "nodemon src/main.ts",
        "lint": "biome check .",
        "precommit": "lint-staged",
        "prepare": "husky install",
        "build": "tsc --noEmit && esbuild src/main.ts --bundle --platform=node --format=cjs --target=node26 --packages=external --outfile=dist/bundle.js",
        "test": "jest --no-cache --detectOpenHandles --forceExit"
    },
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "biome check --write"
        ]
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run precommit"
        }
    },
    "jest": {
        "setupFiles": [
            "./setup-jest.ts"
        ],
        "preset": "ts-jest/presets/js-with-ts",
        "testEnvironment": "node",
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "transform": {
            "^.+\\.js?$": "babel-jest",
            "^.+\\.mjs$": "babel-jest",
            "^.+\\.ts$": "ts-jest"
        },
        "moduleNameMapper": {
            "^@apis(.*)$": "<rootDir>/src/apis$1",
            "^@services(.*)$": "<rootDir>/src/services$1",
            "^@cache(.*)$": "<rootDir>/src/cache$1",
            "^@controllers(.*)$": "<rootDir>/src/controllers$1",
            "^@entityMappers(.*)$": "<rootDir>/src/entityMappers$1"
        }
    },
    "dependencies": {
        "@tailwindcss/typography": "0.5.4",
        "@tv-app-packages/shared-types": "^1.0.0",
        "cors": "^2.8.5",
        "dotenv": "^8.2.0",
        "express": "5.3.0",
        "express-validator": "^7.0.1",
        "http-status": "^1.7.3",
        "joi": "17.13.9",
        "morgan": "^1.10.0",
        "node-cache": "^5.1.2",
        "node-fetch": "^2.7.0",
        "qs": "^6.12.0",
        "swagger-ui-express": "^5.0.0",
        "yamljs": "^0.3.0"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.23.9",
        "@babel/preset-typescript": "^7.23.3",
        "@types/cors": "^2.8.17",
        "@types/dotenv": "^8.2.0",
        "@types/express": "5.0.6",
        "@types/jest": "30.0.0",
        "@types/morgan": "^1.9.9",
        "@types/node-fetch": "^2.6.11",
        "@types/supertest": "7.2.1",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/yamljs": "^0.2.34",
        "babel-jest": "^30.4.1",
        "esbuild": "0.28.2",
        "husky": "^9.0.11",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.2",
        "moq.ts": "^10.0.8",
        "node-mocks-http": "^1.14.1",
        "nodemon": "^3.1.11",
        "supertest": "7.3.2",
        "ts-jest": "29.4.15",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0"
    }
}
